{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lean thesis result coloring artifact",
  "type": "object",
  "required": [
    "schemaVersion",
    "statusPalette",
    "sectionPalette",
    "sectionWorkflows",
    "summary",
    "results",
    "byLabel"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "statusPalette": { "type": "object" },
    "sectionPalette": { "type": "object" },
    "sectionWorkflows": { "type": "object" },
    "summary": { "type": "object" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    },
    "byLabel": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "label",
        "status",
        "color",
        "section",
        "sectionColor",
        "workflow",
        "modules",
        "declarations"
      ],
      "properties": {
        "label": { "type": "string" },
        "status": {
          "enum": ["verified", "external", "commentary", "unknown"]
        },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "section": { "type": "string" },
        "sectionColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "workflow": { "type": "string" },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "declarations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "module", "file", "line"],
            "properties": {
              "name": { "type": ["string", "null"] },
              "kind": { "type": ["string", "null"] },
              "module": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
