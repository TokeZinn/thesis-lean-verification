theorem modification_no_value_of_near {X : Type u} [EMetricSpace X]
    {xi xi₀ : DistinctFiniteSubsets X}
    (hxi : edist xi xi₀ < (1 : ENNReal)) {n : ℕ}
    (hnone : ¬ ∃ z : X,
      IndexAugmented.mk n z ∈ (xi.1 : Set (IndexAugmented X))) :
    ¬ ∃ z : X,
      IndexAugmented.mk n z ∈ (xi₀.1 : Set (IndexAugmented X)) :=
  modification_no_value_of_indexSet_eq (modification_indexSet_eq_of_near hxi) hnone

/--
