theorem modificationValue_edist_lt_of_mem {X : Type u} [EMetricSpace X]
    {xi xi₀ : DistinctFiniteSubsets X} {r : ENNReal}
    (hr : r ≤ (1 : ENNReal)) (hxi : edist xi xi₀ < r)
    {n : ℕ} {z default default₀ : X}
    (hz : IndexAugmented.mk n z ∈ (xi.1 : Set (IndexAugmented X))) :
    edist (modificationValue xi n default)
        (modificationValue xi₀ n default₀) < r := by
  rcases DistinctFiniteSubsets.exists_same_index_near_of_edist_lt hr hxi hz with
    ⟨w, hzw, hw⟩
  have hleft : modificationValue xi n default = z :=
    modificationValue_eq_of_mem xi hz
  have hright : modificationValue xi₀ n default₀ = w :=
    modificationValue_eq_of_mem xi₀ hw
  simpa [hleft, hright] using hzw

