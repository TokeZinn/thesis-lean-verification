Original label: epsilon-delta estimate inside
`thm:analytic-properties-actions`, modification part.

Informal statement: in a fixed-length layer, if the original tuple and
distinct finite modification set are both within `δ`, with `δ ≤ 1`, then the
modified output tuples are within `δ`.

Lean strategy / thesis relation note: the proof follows the thesis: length is unchanged by
modification, the fixed-length tuple metric collapses to coordinate control,
and each coordinate is handled by the modified/unmodified case split above.
-/
theorem modify_edist_lt_of_fixed_near {X : Type u} [EMetricSpace X]
    {m : ℕ} {x x₀ : Fin m → X}
    {xi xi₀ : DistinctFiniteSubsets X} {δ : ENNReal}
    (hδle : δ ≤ (1 : ENNReal))
    (hxδ : edist (Sigma.mk m x : Tuple X) (Sigma.mk m x₀ : Tuple X) < δ)
    (hxiδ : edist xi xi₀ < δ) :
    edist (Primitive.modify (Sigma.mk m x : Tuple X) xi)
        (Primitive.modify (Sigma.mk m x₀ : Tuple X) xi₀) < δ := by
  have hδpos : (⊥ : ENNReal) < δ := lt_of_le_of_lt bot_le hxδ
  have hcoord :
      coordinateEDistSup
          (fun i : Fin m =>
            Tuple.entry (Primitive.modify (Sigma.mk m x : Tuple X) xi) i)
          (fun i : Fin m =>
            Tuple.entry (Primitive.modify (Sigma.mk m x₀ : Tuple X) xi₀) i) < δ := by
    rw [coordinateEDistSup]
    exact (Finset.sup_lt_iff hδpos).mpr
      (fun i _hi => modify_entry_edist_lt_of_fixed_near hδle hxδ hxiδ i)
  calc
    edist (Primitive.modify (Sigma.mk m x : Tuple X) xi)
        (Primitive.modify (Sigma.mk m x₀ : Tuple X) xi₀)
        ≤ coordinateEDistSup
          (fun i : Fin m =>
            Tuple.entry (Primitive.modify (Sigma.mk m x : Tuple X) xi) i)
          (fun i : Fin m =>
            Tuple.entry (Primitive.modify (Sigma.mk m x₀ : Tuple X) xi₀) i) := by
          simpa [Primitive.modify, Tuple.length, Tuple.entry] using
            (fixedLength_edist_le_coordinateEDistSup (X := X)
              (x := fun i : Fin m =>
                Tuple.entry (Primitive.modify (Sigma.mk m x : Tuple X) xi) i)
              (y := fun i : Fin m =>
                Tuple.entry (Primitive.modify (Sigma.mk m x₀ : Tuple X) xi₀) i))
    _ < δ := hcoord

