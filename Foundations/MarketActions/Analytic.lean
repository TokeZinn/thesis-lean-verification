theorem measurable_concat_emetricBorel {X : Type u} [EMetricSpace X] :
    @Measurable (Tuple X × Tuple X) (Tuple X)
      (emetricBorel (Tuple X × Tuple X)) (emetricBorel (Tuple X))
      (fun p : Tuple X × Tuple X => concat p.1 p.2) := by
  letI : TopologicalSpace (Tuple X) := emetricTopology (Tuple X)
  letI : MeasurableSpace (Tuple X) := emetricBorel (Tuple X)
  letI : OpensMeasurableSpace (Tuple X) := ⟨le_rfl⟩
  letI : BorelSpace (Tuple X) := ⟨rfl⟩
  letI : TopologicalSpace (Tuple X × Tuple X) :=
    emetricTopology (Tuple X × Tuple X)
  letI : MeasurableSpace (Tuple X × Tuple X) :=
    emetricBorel (Tuple X × Tuple X)
  letI : OpensMeasurableSpace (Tuple X × Tuple X) := ⟨le_rfl⟩
  exact continuous_concat_emetricTopology.measurable

