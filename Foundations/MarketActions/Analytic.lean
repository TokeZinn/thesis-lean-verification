theorem modification_indexSet_eq_of_near {X : Type u} [EMetricSpace X]
    {xi xi₀ : DistinctFiniteSubsets X}
    (hxi : edist xi xi₀ < (1 : ENNReal)) :
    DistinctFiniteSubsets.indexSet xi =
      DistinctFiniteSubsets.indexSet xi₀ :=
  DistinctFiniteSubsets.indexSet_eq_of_edist_lt_one hxi

/--
Thesis source:
