noncomputable def IsMeasurableSortingRule {X : Type u}
    [EMetricSpace X] [Preorder X] (varsigma : SortingRule X) : Prop :=
  @Measurable (Tuple X) (SortedTuple X)
    (emetricBorel (Tuple X)) (emetricBorel (SortedTuple X))
    varsigma.toSortedTuple

