    @Measurable (Tuple X × FiniteSubsets ℕ) (SortedTuple X)
      (emetricBorel (Tuple X × FiniteSubsets ℕ)) (emetricBorel (SortedTuple X))
      (fun p : Tuple X × FiniteSubsets ℕ => sortedCancel varsigma p.1 p.2) := by
  change @Measurable (Tuple X × FiniteSubsets ℕ) (SortedTuple X)
    (emetricBorel (Tuple X × FiniteSubsets ℕ)) (emetricBorel (SortedTuple X))
    (fun p : Tuple X × FiniteSubsets ℕ => varsigma.toSortedTuple (cancel p.1 p.2))
  exact hvarsigma.comp measurable_cancel_emetricBorel

/--
Thesis source:
`1 - theoretical foundations/3_market_actions.tex`, subsection
"Analytical Results for Primitive Actions".

Original label: `cor:sorted-operations-measurable`, sorted modification part.

Informal statement: if the chosen sorting rule is measurable, then sorted
modification is measurable.
-/
theorem measurable_sortedModify_emetricBorel {X : Type u}
    [EMetricSpace X] [Preorder X] (varsigma : SortingRule X)
    (hvarsigma : IsMeasurableSortingRule varsigma) :
    @Measurable (Tuple X × DistinctFiniteSubsets X) (SortedTuple X)
      (emetricBorel (Tuple X × DistinctFiniteSubsets X))
      (emetricBorel (SortedTuple X))
      (fun p : Tuple X × DistinctFiniteSubsets X =>
        sortedModify varsigma p.1 p.2) := by
  change @Measurable (Tuple X × DistinctFiniteSubsets X) (SortedTuple X)
    (emetricBorel (Tuple X × DistinctFiniteSubsets X)) (emetricBorel (SortedTuple X))
    (fun p : Tuple X × DistinctFiniteSubsets X =>
      varsigma.toSortedTuple (Primitive.modify p.1 p.2))
  exact hvarsigma.comp measurable_modify_emetricBorel

end Analytic
