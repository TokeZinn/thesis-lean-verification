theorem modification_no_value_of_indexSet_eq {X : Type u}
    {xi xi₀ : DistinctFiniteSubsets X}
    (hidx : DistinctFiniteSubsets.indexSet xi =
      DistinctFiniteSubsets.indexSet xi₀)
    {n : ℕ}
    (hnone : ¬ ∃ z : X,
      IndexAugmented.mk n z ∈ (xi.1 : Set (IndexAugmented X))) :
    ¬ ∃ z : X,
      IndexAugmented.mk n z ∈ (xi₀.1 : Set (IndexAugmented X)) := by
  intro hsome
  have hn₀ : n ∈ (DistinctFiniteSubsets.indexSet xi₀ : Set ℕ) :=
    (DistinctFiniteSubsets.mem_indexSet xi₀).mpr hsome
  have hn : n ∈ (DistinctFiniteSubsets.indexSet xi : Set ℕ) := by
    simpa [hidx] using hn₀
  exact hnone ((DistinctFiniteSubsets.mem_indexSet xi).mp hn)

