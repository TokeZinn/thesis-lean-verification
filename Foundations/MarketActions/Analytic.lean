"Analytical Results for Primitive Actions".

Original label: coordinate estimate inside
`thm:analytic-properties-actions`, modification part.

Informal statement: in a fixed-length layer, each modified output coordinate
is within `δ` if both the original tuple and the modification set are within
`δ`, with `δ ≤ 1`.

Lean strategy / thesis relation note: this is the thesis proof split into two cases: modified
coordinates use the distinct-finite-set Hausdorff estimate; unmodified
coordinates use the tuple coordinate estimate.
-/
theorem modify_entry_edist_lt_of_fixed_near {X : Type u} [EMetricSpace X]
    {m : ℕ} {x x₀ : Fin m → X}
    {xi xi₀ : DistinctFiniteSubsets X} {δ : ENNReal}
    (hδle : δ ≤ (1 : ENNReal))
    (hxδ : edist (Sigma.mk m x : Tuple X) (Sigma.mk m x₀ : Tuple X) < δ)
    (hxiδ : edist xi xi₀ < δ) (i : Fin m) :
    edist (Tuple.entry (Primitive.modify (Sigma.mk m x : Tuple X) xi) i)
        (Tuple.entry (Primitive.modify (Sigma.mk m x₀ : Tuple X) xi₀) i) < δ := by
  have hx_one : edist (Sigma.mk m x : Tuple X) (Sigma.mk m x₀ : Tuple X) <
      (1 : ENNReal) :=
    lt_of_lt_of_le hxδ hδle
  have hxi_one : edist xi xi₀ < (1 : ENNReal) :=
    lt_of_lt_of_le hxiδ hδle
  by_cases hmem : ∃ z : X,
      IndexAugmented.mk i.1 z ∈ (xi.1 : Set (IndexAugmented X))
  · rcases hmem with ⟨z, hz⟩
    simpa [Primitive.modify, Tuple.entry] using
      (modificationValue_edist_lt_of_mem hδle hxiδ
        (default := x i) (default₀ := x₀ i) hz)
  · have hmem₀ : ¬ ∃ z : X,
        IndexAugmented.mk i.1 z ∈ (xi₀.1 : Set (IndexAugmented X)) :=
      modification_no_value_of_near hxi_one hmem
    have hleft : modificationValue xi i.1 (x i) = x i :=
      modificationValue_eq_default_of_not_exists xi hmem
    have hright : modificationValue xi₀ i.1 (x₀ i) = x₀ i :=
      modificationValue_eq_default_of_not_exists xi₀ hmem₀
    have hcoord_le :
        edist (x i) (x₀ i) ≤
          edist (Sigma.mk m x : Tuple X) (Sigma.mk m x₀ : Tuple X) :=
      coordinate_edist_le_fixedLength_edist_of_lt_one hx_one i
    have hcoord_lt : edist (x i) (x₀ i) < δ :=
      lt_of_le_of_lt hcoord_le hxδ
    simpa [Primitive.modify, Tuple.entry, hleft, hright] using hcoord_lt

/--
Thesis source:
