/-!
# Preliminary topology and analysis

Mathlib-backed counterparts of every custom theorem-style block in
`A - appendices/analysis.tex`.  The manuscript uses extended-valued
metrics in its foundational definitions, so those definitions are stated for
functions into `ℝ≥0∞`.  Later results that use Mathlib's ordinary metric API
are stated here for `PseudoMetricSpace` or `MetricSpace` types. The companion
`ExtendedAnalysis` and `ExtendedSkorokhod` modules supply those results for
the full extended-distance scope while retaining their original formulas.

The path and time-change definitions at the end support the
Skorokhod proofs imported by the public `Analysis` module. This basic module
contains no project-specific axioms.
-/

noncomputable section

open Filter Function Set TopologicalSpace Topology
open scoped ENNReal NNReal Topology

namespace Thesis.Foundations.Preliminary.Analysis

universe u v w

/-! ## General topology -/

/--
Original block id: `source:A - appendices/analysis.tex:9:defn:1`

Informal statement: a topology is a family of subsets containing the empty
and whole sets and closed under finite intersections and arbitrary unions.

Lean strategy / thesis relation note: Mathlib's `TopologicalSpace` structure
packages exactly these closure laws for typed sets.
-/
abbrev ThesisTopology (X : Type u) := TopologicalSpace X

/--
Original block id: `source:A - appendices/analysis.tex:20:defn:2`

Informal statement: a topological base covers every point and refines the
intersection of any two basic neighborhoods at each point of that intersection.

Lean strategy / thesis relation note: the two thesis clauses are stored
directly, before any ambient topology has been chosen.  This distinction is
important for the later proposition that constructs a topology from the base.
-/
structure IsTopologicalBase {X : Type u} (B : Set (Set X)) : Prop where
  cover : ∀ x : X, ∃ U ∈ B, x ∈ U
  refine_inter : ∀ U ∈ B, ∀ V ∈ B, ∀ x ∈ U ∩ V,
    ∃ W ∈ B, x ∈ W ∧ W ⊆ U ∩ V

/-- The product family appearing in the manuscript. -/
def productBase {X : Type u} {Y : Type v} (BX : Set (Set X)) (BY : Set (Set Y)) :
    Set (Set (X × Y)) :=
  Set.image2 (· ×ˢ ·) BX BY

/--
Original block id: `source:A - appendices/analysis.tex:29:prop:3`

Informal statement: Cartesian products of members of bases on `X` and `Y`
form a topological base on `X × Y`.

Lean strategy / thesis relation note: this is the thesis proof coordinate by
coordinate, carried out directly on the two pre-topological base clauses: for
covering, choose one basic neighbourhood in each coordinate and take their
product; for refinement, refine the intersection in each coordinate with the
given bases and take the product of the two refining sets.  No Mathlib
product-basis theorem is used.
-/
theorem productBase_isTopologicalBase {X : Type u} {Y : Type v}
    {BX : Set (Set X)} {BY : Set (Set Y)}
    (hX : IsTopologicalBase BX) (hY : IsTopologicalBase BY) :
    IsTopologicalBase (productBase BX BY) := by
  constructor
  · intro p
    obtain ⟨UX, hUX, hpX⟩ := hX.cover p.1
    obtain ⟨UY, hUY, hpY⟩ := hY.cover p.2
    exact ⟨UX ×ˢ UY, ⟨UX, hUX, UY, hUY, rfl⟩, ⟨hpX, hpY⟩⟩
  · rintro U ⟨UX, hUX, UY, hUY, rfl⟩
    rintro V ⟨VX, hVX, VY, hVY, rfl⟩
    rintro p ⟨⟨hpUX, hpUY⟩, ⟨hpVX, hpVY⟩⟩
    obtain ⟨WX, hWX, hpWX, hWXsub⟩ :=
      hX.refine_inter UX hUX VX hVX p.1 ⟨hpUX, hpVX⟩
    obtain ⟨WY, hWY, hpWY, hWYsub⟩ :=
      hY.refine_inter UY hUY VY hVY p.2 ⟨hpUY, hpVY⟩
    refine ⟨WX ×ˢ WY, ⟨WX, hWX, WY, hWY, rfl⟩, ⟨hpWX, hpWY⟩, ?_⟩
    rintro q ⟨hqX, hqY⟩
    exact ⟨⟨(hWXsub hqX).1, (hWYsub hqY).1⟩,
      ⟨(hWXsub hqX).2, (hWYsub hqY).2⟩⟩

/-- The topology generated by a pre-topological basis. -/
@[implicit_reducible]
def topologyGeneratedByBase {X : Type u} (B : Set (Set X)) : TopologicalSpace X :=
  TopologicalSpace.generateFrom B

/--
Original label: `prop:topology-base`.

Informal statement: the topology associated with a base consists of unions of
basic sets, equivalently it is the topology generated by that base.

Lean strategy / thesis relation note: install `generateFrom B`, then build
Mathlib's topology-relative basis certificate from the two pre-topological
clauses proved above.  Its `open_iff_eq_sUnion` theorem gives exactly the
manuscript's explicit union representation, without assuming the conclusion.
-/
theorem topologyGeneratedByBase_open_iff {X : Type u}
    {B : Set (Set X)} (hB : IsTopologicalBase B) :
    letI := topologyGeneratedByBase B
    ∀ U : Set X, IsOpen U ↔ ∃ S ⊆ B, U = ⋃₀ S := by
  letI := topologyGeneratedByBase B
  have hMathlib : TopologicalSpace.IsTopologicalBasis B := {
    exists_subset_inter := hB.refine_inter
    sUnion_eq := sUnion_eq_univ_iff.mpr hB.cover
    eq_generateFrom := rfl }
  exact fun _ => hMathlib.open_iff_eq_sUnion

/--
Original block id: `source:A - appendices/analysis.tex:64:defn:5`

Informal statement: a map is continuous when the preimage of every open set
in the codomain is open in the domain.

Lean strategy / thesis relation note: the displayed open-preimage condition
is stated directly; Mathlib's `continuous_def` identifies it with `Continuous`.
-/
def IsContinuousByOpenPreimages {X : Type u} {Y : Type v}
    [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y) : Prop :=
  ∀ U : Set Y, IsOpen U → IsOpen (f ⁻¹' U)

theorem isContinuousByOpenPreimages_iff {X : Type u} {Y : Type v}
    [TopologicalSpace X] [TopologicalSpace Y] {f : X → Y} :
    IsContinuousByOpenPreimages f ↔ Continuous f := by
  simpa [IsContinuousByOpenPreimages] using (continuous_def :
    Continuous f ↔ ∀ s, IsOpen s → IsOpen (f ⁻¹' s)).symm

/--
Original label: `defn:Hausdorff`.

Informal statement: a space is Hausdorff when distinct points admit disjoint
open neighborhoods.

Lean strategy / thesis relation note: Mathlib's `T2Space` is precisely the
Hausdorff separation property used by the thesis.
-/
abbrev HausdorffSpace (X : Type u) [TopologicalSpace X] := T2Space X

/--
Original label: `defn:second-countable`.

Informal statement: a space is second-countable when its topology has a
countable base.

Lean strategy / thesis relation note: `SecondCountableTopology` is Mathlib's
propositional mixin asserting the existence of such a countable basis.
-/
abbrev IsSecondCountable (X : Type u) [TopologicalSpace X] :=
  SecondCountableTopology X

/--
Original block id: `source:A - appendices/analysis.tex:96:defn:8`

Informal statement: the subspace topology on `Y ⊆ X` consists of intersections
of `Y` with open subsets of `X`.

Lean strategy / thesis relation note: the topology induced by the subtype
inclusion is Mathlib's subspace topology; preimages under that inclusion are
exactly the intersections displayed in the thesis.
-/
@[implicit_reducible]
def subspaceTopology {X : Type u} [t : TopologicalSpace X] (Y : Set X) :
    TopologicalSpace Y :=
  TopologicalSpace.induced ((↑) : Y → X) t

/-- An open cover in the exact set-family formulation used in the thesis. -/
def IsOpenCover {X : Type u} [TopologicalSpace X] (U : Set (Set X)) : Prop :=
  (∀ O ∈ U, IsOpen O) ∧ ⋃₀ U = Set.univ

/--
Original block id: `source:A - appendices/analysis.tex:104:defn:9`

Informal statement: an open cover is a family of open sets whose union is the
whole space, and a subcover is a subfamily that still covers.

Lean strategy / thesis relation note: `IsOpenCover` records openness and the
union equation, while this predicate adds the two subcover requirements
verbatim.
-/
def IsOpenSubcover {X : Type u} [TopologicalSpace X]
    (V U : Set (Set X)) : Prop :=
  IsOpenCover U ∧ V ⊆ U ∧ IsOpenCover V

/--
Original block id: `source:A - appendices/analysis.tex:113:defn:10`

Informal statement: a subset is compact when every open cover in its subspace
topology has a finite subcover.

Lean strategy / thesis relation note: Mathlib's `IsCompact` is the standard
cover/filter-equivalent notion for subsets and specializes to the thesis
definition on the subtype.
-/
abbrev IsCompactSet {X : Type u} [TopologicalSpace X] := @IsCompact X _

/-! ## Extended metrics and metric topology -/

/--
Original label: `defn:metric`.

Informal statement: an extended metric is an `ℝ≥0∞`-valued distance that
vanishes exactly on equal points, is symmetric, and satisfies the triangle
inequality.

Lean strategy / thesis relation note: this predicate spells out the thesis's
three numbered axioms without imposing Mathlib's finiteness convention for
ordinary `MetricSpace` distances.
-/
def IsExtendedMetric {X : Type u} (d : X → X → ℝ≥0∞) : Prop :=
  (∀ x y, d x y = 0 ↔ x = y) ∧
    (∀ x y, d x y = d y x) ∧
    ∀ x y z, d x z ≤ d x y + d y z

/-- The bounded truncation from the extended-metric convention. -/
def truncatedEDistance {X : Type u} (d : X → X → ℝ≥0∞) (x y : X) : ℝ≥0∞ :=
  min (d x y) 1

/--
Original label: `rem:extended-metric-convention`

Informal statement: truncating an extended metric by `1` is again a metric and
leaves every ball of radius at most `1` unchanged, so all local metric notions
are unchanged.

Lean strategy / thesis relation note: the equality of small balls is the local
calculation used in the manuscript's argument for equal topology, convergence,
Cauchy sequences, completeness, and separability.  The metric axioms for the
truncation are verified explicitly as well.
-/
theorem truncatedEDistance_properties {X : Type u} (d : X → X → ℝ≥0∞)
    (hd : IsExtendedMetric d) :
    IsExtendedMetric (truncatedEDistance d) ∧
      ∀ x : X, ∀ {ε : ℝ≥0∞}, ε ≤ 1 →
        {y | truncatedEDistance d x y < ε} = {y | d x y < ε} := by
  rcases hd with ⟨hd0, hdsymm, hdtriangle⟩
  constructor
  · refine ⟨?_, ?_, ?_⟩
    · intro x y
      simp [truncatedEDistance, hd0]
    · intro x y
      simp only [truncatedEDistance, hdsymm x y]
    · intro x y z
      by_cases hxy : d x y ≤ 1
      · rw [truncatedEDistance, truncatedEDistance, min_eq_left hxy]
        by_cases hyz : d y z ≤ 1
        · rw [truncatedEDistance, min_eq_left hyz]
          exact (min_le_left _ _).trans (hdtriangle x y z)
        · rw [truncatedEDistance, min_eq_right (le_of_not_ge hyz)]
          exact (min_le_right _ _).trans (by simp)
      · rw [truncatedEDistance, truncatedEDistance,
          min_eq_right (le_of_not_ge hxy)]
        exact (min_le_right _ _).trans (by simp)
  · intro x ε hε
    ext y
    simp only [mem_setOf_eq, truncatedEDistance, min_lt_iff]
    exact or_iff_left (not_lt_of_ge hε)

/--
Original label: `defn:pseudometric`.

Informal statement: an extended pseudometric is symmetric, satisfies the
triangle inequality, and has zero self-distance, but need not separate points.

Lean strategy / thesis relation note: the three clauses are recorded directly
for an `ℝ≥0∞`-valued function, preserving the thesis's extended convention.
-/
def IsExtendedPseudometric {X : Type u} (d : X → X → ℝ≥0∞) : Prop :=
  (∀ x, d x x = 0) ∧
    (∀ x y, d x y = d y x) ∧
    ∀ x y z, d x z ≤ d x y + d y z

/--
Original label: `cor:pseudometric-metric-relation`.

Informal statement: every metric is a pseudometric, and a pseudometric is a
metric exactly when zero distance forces equality.

Lean strategy / thesis relation note: unfolding the two preceding predicates
reduces the first part to the metric zero axiom at `(x,x)` and the second part
to adjoining the missing separation clause.
-/
theorem extendedMetric_pseudometric_relation {X : Type u}
    {d ρ : X → X → ℝ≥0∞} (hd : IsExtendedMetric d)
    (hρ : IsExtendedPseudometric ρ) :
    IsExtendedPseudometric d ∧
      (IsExtendedMetric ρ ↔ ∀ x y, ρ x y = 0 → x = y) := by
  rcases hd with ⟨hd0, hds, hdt⟩
  rcases hρ with ⟨hρ0, hρs, hρt⟩
  constructor
  · exact ⟨fun x => (hd0 x x).2 rfl, hds, hdt⟩
  · constructor
    · intro hm x y hxy
      exact (hm.1 x y).1 hxy
    · intro hsep
      exact ⟨fun x y => ⟨hsep x y, fun h => h ▸ hρ0 x⟩, hρs, hρt⟩

/-- The family of all positive-radius extended-metric balls. -/
def metricBallFamily (X : Type u) [PseudoEMetricSpace X] : Set (Set X) :=
  {U | ∃ x : X, ∃ ε : ℝ≥0∞, 0 < ε ∧ U = Metric.eball x ε}

/--
Original label: `prop:topology-extended-pseudometric` (refinement step).

The manuscript's explicit radius: for `x ∈ B(c,ε) ∩ B(c′,δ)` the half-minimum
slack `r = ½ min{ε − d(c,x), δ − d(c′,x)}` is strictly positive, and the
triangle inequality `d(c,y) ≤ d(c,x) + d(x,y) < d(c,x) + r ≤ ε` (and likewise
for `c′`) puts `B(x,r)` inside both balls.  Extended radii are harmless because
both centre distances are finite.
-/
theorem half_slack_refinement {X : Type u} [PseudoEMetricSpace X]
    (c d x : X) (ε δ : ℝ≥0∞) (hx : x ∈ Metric.eball c ε ∩ Metric.eball d δ) :
    let r := min (ε - edist c x) (δ - edist d x) / 2
    0 < r ∧ x ∈ Metric.eball x r ∧
      Metric.eball x r ⊆ Metric.eball c ε ∩ Metric.eball d δ := by
  have hc : edist c x < ε := by simpa only [Metric.mem_eball, edist_comm] using hx.1
  have hd : edist d x < δ := by simpa only [Metric.mem_eball, edist_comm] using hx.2
  have hcf : edist c x ≠ ∞ := ne_of_lt (hc.trans_le le_top)
  have hdf : edist d x ≠ ∞ := ne_of_lt (hd.trans_le le_top)
  let r := min (ε - edist c x) (δ - edist d x) / 2
  have hr : 0 < r := ENNReal.div_pos
    (ne_of_gt (lt_min (tsub_pos_iff_lt.mpr hc) (tsub_pos_iff_lt.mpr hd))) (by norm_num)
  refine ⟨hr, Metric.mem_eball_self hr, ?_⟩
  intro y hy
  have hxy : edist x y < r := by simpa only [Metric.mem_eball, edist_comm] using hy
  have hrε : r ≤ ε - edist c x := ENNReal.half_le_self.trans (min_le_left _ _)
  have hrδ : r ≤ δ - edist d x := ENNReal.half_le_self.trans (min_le_right _ _)
  have hce : edist c x + edist x y < ε :=
    (ENNReal.cancel_of_ne hcf).lt_tsub_iff_left.mp (hxy.trans_le hrε)
  have hde : edist d x + edist x y < δ :=
    (ENNReal.cancel_of_ne hdf).lt_tsub_iff_left.mp (hxy.trans_le hrδ)
  exact ⟨by simpa only [Metric.mem_eball, edist_comm y c] using
      (edist_triangle c x y).trans_lt hce,
    by simpa only [Metric.mem_eball, edist_comm y d] using
      (edist_triangle d x y).trans_lt hde⟩

/--
Original label: `prop:topology-extended-pseudometric`.

Informal statement: positive-radius balls of a pseudometric form a topological
base for the topology induced by that pseudometric.

Lean strategy / thesis relation note: this is the manuscript proof.  Covering:
`d(x,x) = 0 < 1` puts `x` in `B(x,1)`.  Refinement: for
`x ∈ B(c,ε) ∩ B(c′,δ)`, the half-minimum slack radius of
`half_slack_refinement` yields a ball `B(x,r)` of the family inside the
intersection, by the triangle inequality.  No Mathlib neighbourhood basis or
topology-relative basis certificate is used.
-/
theorem metricBalls_isTopologicalBase (X : Type u) [PseudoEMetricSpace X] :
    IsTopologicalBase (metricBallFamily X) := by
  refine ⟨fun x => ⟨Metric.eball x 1, ⟨x, 1, zero_lt_one, rfl⟩,
    Metric.mem_eball_self zero_lt_one⟩, ?_⟩
  rintro _ ⟨c, ε, _, rfl⟩ _ ⟨d, δ, _, rfl⟩ x hx
  let r := min (ε - edist c x) (δ - edist d x) / 2
  have h := half_slack_refinement c d x ε δ hx
  exact ⟨Metric.eball x r, ⟨x, r, h.1, rfl⟩, h.2⟩

/--
Original label: `defn:distance-to-set`.

Informal statement: the extended distance from `x` to `B` is the infimum of
the distances from `x` to points of `B`, with distance to the empty set equal
to infinity.

Lean strategy / thesis relation note: this is Mathlib's `Metric.infEDist`, whose
definition is the required infimum and whose theorem `infEDist_empty` supplies
the empty-set convention.
-/
def distanceToSet {X : Type u} [PseudoEMetricSpace X] (x : X) (B : Set X) : ℝ≥0∞ :=
  Metric.infEDist x B

/--
Original block id: `source:A - appendices/analysis.tex:232:defn:17`

Informal statement: Hausdorff distance is the maximum of the two directed
supremum distances between subsets, with the stated empty-set conventions.

Lean strategy / thesis relation note: Mathlib's `Metric.hausdorffEDist` uses
`infEDist` and the same two directed suprema, including the manuscript's
extended-valued empty-set behavior.
-/
def hausdorffDistance {X : Type u} [PseudoEMetricSpace X] (A B : Set X) : ℝ≥0∞ :=
  Metric.hausdorffEDist A B

/--
Original label: `prop:hausdorff-distance`.

Informal statement: Hausdorff distance is an extended pseudometric on the
power set of a metric space.

Lean strategy / thesis relation note: Mathlib proves self-distance, symmetry,
and the Hausdorff triangle inequality and packages them in
`PseudoEMetricSpace.hausdorff`; returning that structure verifies all three
axioms at once.
-/
@[implicit_reducible]
def powerSetHausdorffPseudoEMetricSpace (X : Type u) [PseudoEMetricSpace X] :
    PseudoEMetricSpace (Set X) :=
  PseudoEMetricSpace.hausdorff

/--
Original block id: `source:A - appendices/analysis.tex:255:prop:19` (separation step).

Two balls of radius `ε = ½ min{d(x,y), 1}` around points at positive distance
are disjoint: a common point `z` would give
`d(x,y) ≤ d(x,z) + d(z,y) < 2ε = min{d(x,y),1} ≤ d(x,y)`, exactly as in the
manuscript.
-/
theorem half_distance_balls_disjoint {X : Type u} [PseudoEMetricSpace X]
    (x y : X) (hxy : 0 < edist x y) :
    let r := min (edist x y) 1 / 2
    0 < r ∧ Disjoint (Metric.eball x r) (Metric.eball y r) := by
  let r := min (edist x y) 1 / 2
  have hr : 0 < r := ENNReal.div_pos (ne_of_gt (lt_min hxy zero_lt_one)) (by norm_num)
  refine ⟨hr, Set.disjoint_left.mpr ?_⟩
  intro z hx hy
  have hxz : edist x z < r := by simpa only [Metric.mem_eball, edist_comm] using hx
  have hzy : edist z y < r := hy
  have hrf : r ≠ ∞ := ne_of_lt ((ENNReal.half_le_self.trans (min_le_right _ _)).trans_lt
    (by norm_num : (1 : ℝ≥0∞) < ∞))
  have hsum : edist x z + edist z y < r + r :=
    (ENNReal.add_lt_add_right (ne_of_lt (hzy.trans_le le_top)) hxz).trans
      (ENNReal.add_lt_add_left hrf hzy)
  have he : r + r = min (edist x y) 1 := ENNReal.add_halves _
  exact not_lt_of_ge ((edist_triangle x z y).trans
    (hsum.le.trans (he ▸ min_le_left _ _)))
      ((edist_triangle x z y).trans_lt (hsum.trans_le (he ▸ min_le_left _ _)))

/--
Original block id: `source:A - appendices/analysis.tex:255:prop:19`

Informal statement: the topology of a pseudometric is Hausdorff exactly when
zero distance separates points.

Lean strategy / thesis relation note: both directions follow the manuscript.
If zero distance separates points, two distinct points have positive distance
and the disjoint half-distance balls of `half_distance_balls_disjoint` are the
required open neighbourhoods.  Conversely, if the space is Hausdorff but
`d(x,y) = 0` with `x ≠ y`, pick disjoint open neighbourhoods `U ∋ x`, `V ∋ y`;
the centred-ball characterisation of open sets gives a ball `B(x,ε) ⊆ U`, and
`d(x,y) = 0 < ε` puts `y` in `U`, contradicting disjointness.
-/
theorem pseudoEMetricTopology_hausdorff_iff {X : Type u} [PseudoEMetricSpace X] :
    Nonempty (T2Space X) ↔ ∀ x y : X, edist x y = 0 → x = y := by
  constructor
  · rintro ⟨hT2⟩ x y hzero
    letI : T2Space X := hT2
    by_contra hne
    obtain ⟨U, V, hU, _, hx, hy, hd⟩ := t2_separation hne
    obtain ⟨ε, hε, hsub⟩ := EMetric.isOpen_iff.mp hU x hx
    have hyU : y ∈ U := hsub (by simpa only [Metric.mem_eball, edist_comm, hzero] using hε)
    exact Set.disjoint_left.mp hd hyU hy
  · intro hsep
    refine ⟨⟨fun x y hne => ?_⟩⟩
    have hpos : 0 < edist x y := pos_iff_ne_zero.mpr (fun h => hne (hsep x y h))
    let r := min (edist x y) 1 / 2
    have h := half_distance_balls_disjoint x y hpos
    exact ⟨Metric.eball x r, Metric.eball y r, Metric.isOpen_eball, Metric.isOpen_eball,
      Metric.mem_eball_self h.1, Metric.mem_eball_self h.1, h.2⟩

/-! ## Sequences, completeness, separability, and Polishness -/

/--
Original label: `defn:Cauchy-sequence`.

Informal statement: a sequence is Cauchy when all sufficiently late pairs of
terms are arbitrarily close.

Lean strategy / thesis relation note: Mathlib's filter definition `CauchySeq`
is equivalent to the displayed epsilon-tail condition in a metric space.
-/
abbrev IsCauchySequence {X : Type u} [UniformSpace X] (x : ℕ → X) : Prop :=
  CauchySeq x

/--
Original label: `defn:convergent-sequence`.

Informal statement: a sequence converges when it tends to some point of the
space; that point is its limit.

Lean strategy / thesis relation note: `Tendsto x atTop (𝓝 limit)` is Mathlib's
filter form of the manuscript's epsilon-and-eventual-tail quantifiers.
-/
def IsConvergentSequence {X : Type u} [TopologicalSpace X] (x : ℕ → X) : Prop :=
  ∃ limit : X, Tendsto x atTop (𝓝 limit)

/--
Original label: `defn:complete-space`.

Informal statement: a metric space is complete when every Cauchy sequence has
a limit in the space.

Lean strategy / thesis relation note: Mathlib's `CompleteSpace` is the
uniform-space version of this condition and is equivalent to sequential
completeness for metric spaces.
-/
abbrev IsCompleteMetricSpace (X : Type u) [UniformSpace X] := CompleteSpace X

/--
Original label: `defn:separable`.

Informal statement: a metric space is separable when it has a countable dense
subset.

Lean strategy / thesis relation note: Mathlib's `SeparableSpace` is exactly the
existence of a countable dense set; metric density unfolds to the displayed
epsilon approximation property.
-/
abbrev IsSeparableMetricSpace (X : Type u) [TopologicalSpace X] :=
  TopologicalSpace.SeparableSpace X

/--
Original block id: `source:A - appendices/analysis.tex:327:defn:25`

Informal statement: a Polish space has a compatible complete separable metric.

Lean strategy / thesis relation note: Mathlib's `PolishSpace` combines second
countability with complete metrizability, an equivalent topological
formulation of the thesis definition.
-/
abbrev IsPolishSpace (X : Type u) [TopologicalSpace X] := PolishSpace X

/-! ## Function and path spaces -/

/--
Original block id: `source:A - appendices/analysis.tex:376:defn:32`

Informal statement: a map between metric spaces is continuous when every
epsilon at every base point admits a delta controlling the image distance.

Lean strategy / thesis relation note: the predicate transcribes the displayed
epsilon-delta formula literally; Mathlib's metric continuity lemmas identify
it with topological `Continuous`.
-/
def EpsilonDeltaContinuous {X : Type u} {Y : Type v}
    [PseudoMetricSpace X] [PseudoMetricSpace Y] (f : X → Y) : Prop :=
  ∀ x₀ : X, ∀ ε > 0, ∃ δ > 0, ∀ x : X,
    dist x x₀ < δ → dist (f x) (f x₀) < ε

/-- The compact real interval used as the path domain. -/
abbrev ClosedInterval (a b : ℝ) := Set.Icc a b

/-! ### Separability of `C([a,b];X)` by rational windows

The manuscript's countable family for `prop:spc-continuous`: rational interval
windows `[s_{k-1}, s_k]`, centres `y_k` taken from a countable dense sequence,
and a rational radius `q`.  A window is a triple `(s, s′, n)` consisting of
rational endpoints and the index `n` of its centre `d n`; the constraint cell
of a finite covering window family with radius `q` consists of the continuous
paths mapping every window into the `q`-ball around its centre.  One path is
chosen from each nonempty cell. -/
namespace ContinuousPathSeparability

/-- A rational window `[s, s′]` together with the index of its centre. -/
abbrev Window := ℚ × ℚ × ℕ

/-- The times of `[a,b]` lying in the rational window. -/
def region {a b : ℝ} (w : Window) : Set (ClosedInterval a b) :=
  {t | (w.1 : ℝ) ≤ t ∧ (t : ℝ) ≤ w.2.1}

/-- A finite window family covers `[a,b]`. -/
def Covers {a b : ℝ} (s : Finset Window) : Prop :=
  ∀ t : ClosedInterval a b, ∃ w ∈ s, t ∈ region w

/-- The constraint cell: the windows cover `[a,b]`, and on every window the
path stays within the rational radius `i.2` of the window's centre. -/
def constraint {a b : ℝ} {X : Type u} [MetricSpace X]
    (d : ℕ → X) (i : Finset Window × ℚ) : Set C(ClosedInterval a b, X) :=
  {f | Covers (a := a) (b := b) i.1 ∧
    ∀ w ∈ i.1, ∀ t ∈ region w, dist (f t) (d w.2.2) < i.2}

/-- The manuscript's approximation step: uniform continuity of `f` on the
compact interval gives a finite cover by rational windows on each of which `f`
stays within `2ε` of a centre `d n`; with a rational radius `q ∈ (2ε, 3ε)`, `f`
lies in the resulting cell, and every member `g` of that cell satisfies
`d(f(t), g(t)) ≤ d(f(t), y_k) + d(y_k, g(t)) < 5ε` on every window, hence
`d_∞(f,g) < 6ε`. -/
theorem exists_constraint {a b : ℝ} {X : Type u} [MetricSpace X]
    (d : ℕ → X) (hd : DenseRange d) (f : C(ClosedInterval a b, X)) (ε : ℝ) (hε : 0 < ε) :
    ∃ i : Finset Window × ℚ, f ∈ constraint d i ∧
      ∀ g ∈ constraint d i, dist f g < ε := by
  classical
  let e := ε / 6
  have he : 0 < e := by dsimp [e]; positivity
  obtain ⟨q : ℚ, hqlo, hqhi⟩ := exists_rat_btwn (by linarith : 2 * e < 3 * e)
  obtain ⟨δ, hδ, huc⟩ := Metric.uniformContinuous_iff.mp
    (CompactSpace.uniformContinuous_of_continuous f.continuous) e he
  let Good := {w : Window // ∀ t ∈ region (a := a) (b := b) w,
    dist (f t) (d w.2.2) < 2 * e}
  let U : Good → Set (ClosedInterval a b) := fun w =>
    {t | (w.1.1 : ℝ) < t ∧ (t : ℝ) < w.1.2.1}
  have hopen : ∀ w, IsOpen (U w) := fun w =>
    isOpen_Ioo.preimage continuous_subtype_val
  have hcover : (univ : Set (ClosedInterval a b)) ⊆ ⋃ w : Good, U w := by
    intro t _
    obtain ⟨n, hn⟩ := hd.exists_dist_lt (f t) he
    obtain ⟨r : ℚ, hrlo, hrhi⟩ := exists_rat_btwn (by linarith : (t : ℝ) - δ < t)
    obtain ⟨s : ℚ, hslo, hshi⟩ := exists_rat_btwn (by linarith : (t : ℝ) < t + δ)
    let w : Window := (r, s, n)
    have hw : ∀ v ∈ region (a := a) (b := b) w, dist (f v) (d w.2.2) < 2 * e := by
      intro v hv
      have hvt : dist v t < δ := by
        change |(v : ℝ) - (t : ℝ)| < δ
        apply abs_lt.mpr
        change (r : ℝ) ≤ v ∧ (v : ℝ) ≤ s at hv
        constructor <;> linarith
      exact (dist_triangle (f v) (f t) (d n)).trans_lt (by linarith [huc hvt])
    exact mem_iUnion.mpr ⟨⟨w, hw⟩, by exact ⟨hrhi, hslo⟩⟩
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover U hopen hcover
  let windows : Finset Window := s.image Subtype.val
  have hcovers : Covers (a := a) (b := b) windows := by
    intro t
    have ht := hs (mem_univ t)
    simp only [mem_iUnion] at ht
    obtain ⟨w, hw, ht⟩ := ht
    exact ⟨w.1, Finset.mem_image.mpr ⟨w, hw, rfl⟩, ht.1.le, ht.2.le⟩
  have hsmall : ∀ w ∈ windows, ∀ t ∈ region (a := a) (b := b) w,
      dist (f t) (d w.2.2) < 2 * e := by
    intro w hw
    obtain ⟨v, _, rfl⟩ := Finset.mem_image.mp hw
    exact v.property
  refine ⟨(windows, q), ⟨hcovers, fun w hw t ht => (hsmall w hw t ht).trans hqlo⟩, ?_⟩
  intro g hg
  have hbound : dist f g ≤ 5 * e := (ContinuousMap.dist_le (by positivity)).mpr (fun t => by
    obtain ⟨w, hw, ht⟩ := hcovers t
    have hf := hsmall w hw t ht
    have hgt := hg.2 w hw t ht
    exact (dist_triangle (f t) (d w.2.2) (g t)).trans (by
      rw [dist_comm (d w.2.2) (g t)]
      linarith))
  exact hbound.trans_lt (by dsimp [e]; linarith)

end ContinuousPathSeparability

/--
Original label: `prop:spc-continuous`.

Informal statement: continuous maps from `[a,b]` to a metric space carry the
supremum metric `d_∞(f,g) = sup_t d(f(t),g(t))`; if the target is complete and
separable, so is this path space.

Lean strategy / thesis relation note: the first conjunct records the
manuscript's supremum formula for the distance on `C([a,b];X)`
(`ContinuousMap.dist_eq_iSup`, Mathlib's sup metric on continuous maps from a
compact domain).  Completeness is Mathlib's uniform-limit theorem for
continuous maps on a compact domain.  Separability follows the manuscript's
rational-window construction in `ContinuousPathSeparability`: one path is
chosen from each nonempty cell of covering rational windows, dense-sequence
centres and rational radius; the cells are countable, and
`ContinuousPathSeparability.exists_constraint` places every `f` in a cell all
of whose members are uniformly within `ε` of `f`.  (An empty target makes the
path space a subsingleton, which is trivially separable.)
-/
theorem continuousPathSpace_metric_complete_separable
    (a b : ℝ) (X : Type u) [MetricSpace X] [CompleteSpace X]
    [TopologicalSpace.SeparableSpace X] :
    (∀ f g : C(ClosedInterval a b, X), dist f g = ⨆ t, dist (f t) (g t)) ∧
      Nonempty (CompleteSpace C(ClosedInterval a b, X)) ∧
      Nonempty (TopologicalSpace.SeparableSpace C(ClosedInterval a b, X)) := by
  refine ⟨fun f g => ContinuousMap.dist_eq_iSup, ⟨inferInstance⟩, ⟨?_⟩⟩
  classical
  rcases isEmpty_or_nonempty X with hX | hX
  · haveI : Subsingleton C(ClosedInterval a b, X) :=
      ⟨fun f g => ContinuousMap.ext fun t => (hX.false (f t)).elim⟩
    exact ⟨⟨Set.univ, Set.countable_univ, dense_univ⟩⟩
  · haveI : Nonempty X := hX
    obtain ⟨d : ℕ → X, hd⟩ := exists_dense_seq X
    let Index := {i : Finset ContinuousPathSeparability.Window × ℚ //
      (ContinuousPathSeparability.constraint (a := a) (b := b) d i).Nonempty}
    let chosen : Index → C(ClosedInterval a b, X) := fun i => Classical.choose i.property
    have hchosen : ∀ i, chosen i ∈ ContinuousPathSeparability.constraint d i.1 :=
      fun i => Classical.choose_spec i.property
    refine ⟨Set.range chosen, Set.countable_range chosen, ?_⟩
    apply Metric.dense_iff.mpr
    intro f ε hε
    obtain ⟨i, hfi, hnear⟩ := ContinuousPathSeparability.exists_constraint d hd f ε hε
    let j : Index := ⟨i, ⟨f, hfi⟩⟩
    refine ⟨chosen j, ⟨?_, ⟨j, rfl⟩⟩⟩
    simpa only [Metric.mem_ball, dist_comm] using (hnear (chosen j) (hchosen j))

/-- The graph of a continuous path. -/
def continuousGraph {a b : ℝ} {X : Type u}
    [TopologicalSpace X] (f : C(ClosedInterval a b, X)) :
    Set (ClosedInterval a b × X) :=
  Set.range fun t => (t, f t)

/--
Original block id: `source:A - appendices/analysis.tex:408:prop:34`

Informal statement: the graph of a continuous map on a closed bounded interval
is compact, hence closed and bounded in the product metric.

Lean strategy / thesis relation note: this follows the thesis proof verbatim:
`t ↦ (t,f t)` is continuous, the interval subtype is compact, and its range is
therefore compact.  Mathlib then derives closedness and metric boundedness.
-/
theorem continuousGraph_compact_closed_bounded {a b : ℝ} {X : Type u}
    [MetricSpace X] (f : C(ClosedInterval a b, X)) :
    IsCompact (continuousGraph f) ∧ IsClosed (continuousGraph f) ∧
      Bornology.IsBounded (continuousGraph f) := by
  have hcontinuous : Continuous (fun t : ClosedInterval a b => (t, f t)) :=
    continuous_id.prodMk f.continuous
  have hcompact : IsCompact (continuousGraph f) := by
    exact isCompact_range hcontinuous
  exact ⟨hcompact, hcompact.isClosed, hcompact.isBounded⟩

/-- Right continuity on a closed interval, in the one-sided epsilon form. -/
def IsRightContinuousOnIcc {X : Type u} [PseudoMetricSpace X]
    {a b : ℝ} (f : ClosedInterval a b → X) : Prop :=
  ∀ t₀ : ClosedInterval a b, (t₀ : ℝ) < b → ∀ ε > 0,
    ∃ δ > 0, ∀ t : ClosedInterval a b,
      (t₀ : ℝ) < t → (t : ℝ) < min ((t₀ : ℝ) + δ) b →
        dist (f t) (f t₀) < ε

/-- Left continuity on a closed interval, in the one-sided epsilon form. -/
def IsLeftContinuousOnIcc {X : Type u} [PseudoMetricSpace X]
    {a b : ℝ} (f : ClosedInterval a b → X) : Prop :=
  ∀ t₀ : ClosedInterval a b, a < (t₀ : ℝ) → ∀ ε > 0,
    ∃ δ > 0, ∀ t : ClosedInterval a b,
      max a ((t₀ : ℝ) - δ) < t → (t : ℝ) < t₀ →
        dist (f t) (f t₀) < ε

/-- Existence of right limits at all nonterminal times. -/
def HasRightLimitsOnIcc {X : Type u} [PseudoMetricSpace X]
    {a b : ℝ} (f : ClosedInterval a b → X) : Prop :=
  ∀ t₀ : ClosedInterval a b, (t₀ : ℝ) < b → ∃ R : X, ∀ ε > 0,
    ∃ δ > 0, ∀ t : ClosedInterval a b,
      (t₀ : ℝ) < t → (t : ℝ) < min ((t₀ : ℝ) + δ) b → dist (f t) R < ε

/-- Existence of left limits at all noninitial times. -/
def HasLeftLimitsOnIcc {X : Type u} [PseudoMetricSpace X]
    {a b : ℝ} (f : ClosedInterval a b → X) : Prop :=
  ∀ t₀ : ClosedInterval a b, a < (t₀ : ℝ) → ∃ L : X, ∀ ε > 0,
    ∃ δ > 0, ∀ t : ClosedInterval a b,
      max a ((t₀ : ℝ) - δ) < t → (t : ℝ) < t₀ → dist (f t) L < ε

/-- The two one-sided path orientations used below. -/
inductive PathOrientation
  | cadlag
  | caglad
  deriving DecidableEq

/--
Original block id: `source:A - appendices/analysis.tex:425:defn:35`

Informal statement: càdlàg paths are right-continuous with left limits, while
càglàd paths are left-continuous with right limits, with all four one-sided
conditions interpreted on `[a,b]` as displayed in the thesis.

Lean strategy / thesis relation note: the four auxiliary predicates above are
literal epsilon-delta transcriptions.  This definition combines the correct
two predicates for each orientation and therefore also makes endpoint clauses
explicit.
-/
def IsOneSidedRegularPath {X : Type u} [PseudoMetricSpace X]
    {a b : ℝ} (side : PathOrientation) (f : ClosedInterval a b → X) : Prop :=
  match side with
  | .cadlag => IsRightContinuousOnIcc f ∧ HasLeftLimitsOnIcc f
  | .caglad => IsLeftContinuousOnIcc f ∧ HasRightLimitsOnIcc f

/-- The subtype of càdlàg or càglàd paths. -/
abbrev RegularPath (a b : ℝ) (X : Type u) [PseudoMetricSpace X]
    (side : PathOrientation) :=
  {f : ClosedInterval a b → X // IsOneSidedRegularPath side f}

/--
Original block id: `source:A - appendices/analysis.tex:478:defn:37`

Informal statement: `Λ([a,b])` consists of strictly increasing bijections of
the interval to itself; their logarithmic distortion is the supremum of the
logarithm of all secant-slope ratios.

Lean strategy / thesis relation note: strict monotonicity and bijectivity are
stored as fields.  The companion `timeDistortion` definition immediately below
is the exact supremum formula from the formal block.
-/
structure IncreasingIntervalBijection (a b : ℝ) where
  toFun : ClosedInterval a b → ClosedInterval a b
  strictMono : StrictMono toFun
  bijective : Function.Bijective toFun

instance (a b : ℝ) : CoeFun (IncreasingIntervalBijection a b)
    (fun _ => ClosedInterval a b → ClosedInterval a b) :=
  ⟨IncreasingIntervalBijection.toFun⟩

/-- The secant-slope ratio of an interval time change. -/
def timeChangeSecantSlope {a b : ℝ} (timeChange : IncreasingIntervalBijection a b)
    (s t : ClosedInterval a b) : ℝ :=
  (((timeChange t : ClosedInterval a b) : ℝ) -
      ((timeChange s : ClosedInterval a b) : ℝ)) / ((t : ℝ) - (s : ℝ))

/-- The logarithmic time distortion `‖λ‖∘`, allowing the value `∞`. -/
def timeDistortion {a b : ℝ}
    (timeChange : IncreasingIntervalBijection a b) : ℝ≥0∞ :=
  sSup {r : ℝ≥0∞ | ∃ s t : ClosedInterval a b, (s : ℝ) < t ∧
    r = ENNReal.ofReal |Real.log (timeChangeSecantSlope timeChange s t)|}

/-- Extended supremum distance between two interval paths. -/
def supPathEDistance {a b : ℝ} {X : Type u} [PseudoEMetricSpace X]
    (f g : ClosedInterval a b → X) : ℝ≥0∞ :=
  sSup (Set.range fun t => edist (f t) (g t))

/-- The Skorokhod infimum formula from the thesis. -/
def skorokhodEDistance {a b : ℝ} {X : Type u} [MetricSpace X]
    {side : PathOrientation} (f g : RegularPath a b X side) : ℝ≥0∞ :=
  sInf (Set.range fun timeChange : IncreasingIntervalBijection a b =>
    max (timeDistortion timeChange)
      (supPathEDistance (f : ClosedInterval a b → X)
        (fun t => (g : ClosedInterval a b → X) (timeChange t))))

/-- Cauchy sequences for an explicit extended-valued distance. -/
def IsCauchyFor {Z : Type u} (d : Z → Z → ℝ≥0∞) (x : ℕ → Z) : Prop :=
  ∀ ε > 0, ∃ N, ∀ m ≥ N, ∀ n ≥ N, d (x m) (x n) < ε

/-- Completeness for an explicit extended-valued distance. -/
def IsCompleteFor {Z : Type u} (d : Z → Z → ℝ≥0∞) : Prop :=
  ∀ x : ℕ → Z, IsCauchyFor d x → ∃ limit : Z,
    ∀ ε > 0, ∃ N, ∀ n ≥ N, d (x n) limit < ε

/-- Separability for an explicit extended-valued distance. -/
def IsSeparableFor {Z : Type u} (d : Z → Z → ℝ≥0∞) : Prop :=
  ∃ dense : Set Z, dense.Countable ∧
    ∀ x : Z, ∀ ε > 0, ∃ y ∈ dense, d x y < ε

/-- Convergence for an explicit distance. -/
def ConvergesFor {Z : Type u} (d : Z → Z → ℝ≥0∞)
    (x : ℕ → Z) (limit : Z) : Prop :=
  ∀ ε > 0, ∃ N, ∀ n ≥ N, d (x n) limit < ε

/-- Supremum displacement of a time change from the identity. -/
def timeShiftNorm {a b : ℝ}
    (timeChange : IncreasingIntervalBijection a b) : ℝ≥0∞ :=
  sSup (Set.range fun t : ClosedInterval a b =>
    ENNReal.ofReal |((timeChange t : ClosedInterval a b) : ℝ) - (t : ℝ)|)

/-- Uniform state-space error after applying a time change. -/
def alignedPathError {a b : ℝ} {X : Type u} [MetricSpace X]
    {side : PathOrientation} (g f : RegularPath a b X side)
    (timeChange : IncreasingIntervalBijection a b) : ℝ≥0∞ :=
  sSup (Set.range fun t : ClosedInterval a b =>
    edist ((g : ClosedInterval a b → X) (timeChange t))
      ((f : ClosedInterval a b → X) t))

end Thesis.Foundations.Preliminary.Analysis
