import Thesis.Foundations.Stochastic.FiniteMeasureDensity

/-! # Evaluation and Prokhorov Borel measurability agree

The weak topology is generated by bounded continuous integral tests.
Second countability makes its Borel sigma-algebra generated by those tests.
Conversely, the closed-set form of Portmanteau makes closed-set evaluation
upper semicontinuous; the pi-system argument extends this to every Borel set.
-/

noncomputable section

open Set Filter MeasureTheory Topology TopologicalSpace
open scoped ENNReal NNReal BoundedContinuousFunction

namespace Thesis.Foundations.Stochastic.FiniteMeasureBorel

open FiniteMeasureProkhorov

universe u v

variable {X : Type u} [MeasurableSpace X] [PseudoMetricSpace X] [OpensMeasurableSpace X]

theorem weak_topology_eq_iInf :
    (inferInstance : TopologicalSpace (FiniteMeasure X)) =
      ⨅ f : X →ᵇ ℝ≥0, TopologicalSpace.induced
        (fun μ : FiniteMeasure X => μ.testAgainstNN f) inferInstance := by
  change TopologicalSpace.induced FiniteMeasure.toWeakDualBCNN
    (TopologicalSpace.induced _ Pi.topologicalSpace) = _
  rw [induced_compose]
  change TopologicalSpace.induced (fun μ : FiniteMeasure X => fun f => μ.testAgainstNN f)
    (⨅ f : X →ᵇ ℝ≥0, TopologicalSpace.induced (fun g : (X →ᵇ ℝ≥0) → ℝ≥0 => g f) _) = _
  simp only [induced_iInf, induced_compose, Function.comp_def]

theorem weak_opensMeasurableSpace [TopologicalSpace.SeparableSpace X] :
    OpensMeasurableSpace (FiniteMeasure X) := by
  letI : TopologicalSpace.SeparableSpace (LP X) := FiniteMeasureDensity.separableSpace
  letI : SecondCountableTopology (FiniteMeasure X) :=
    (finiteMeasureHomeomorph (X := X)).secondCountableTopology
  have hb := IsTopologicalBasis.iInf_induced
    (fun _ : X →ᵇ ℝ≥0 => isTopologicalBasis_opens (α := ℝ≥0))
    (fun f : X →ᵇ ℝ≥0 => fun μ : FiniteMeasure X => μ.testAgainstNN f)
  rw [← weak_topology_eq_iInf] at hb
  constructor
  rw [hb.borel_eq_generateFrom]
  apply MeasurableSpace.generateFrom_le
  rintro S ⟨U, F, hU, rfl⟩
  apply MeasurableSet.biInter F.countable_toSet
  intro f hf
  have hm : Measurable (fun μ : FiniteMeasure X => μ.testAgainstNN f) :=
    ENNReal.measurable_toNNReal.comp
      ((Measure.measurable_lintegral (ENNReal.continuous_coe.comp f.continuous).measurable).comp
        measurable_subtype_coe)
  exact hm (show IsOpen (U f) from hU f hf).measurableSet

theorem weak_borelSpace [BorelSpace X] [TopologicalSpace.SeparableSpace X] :
    BorelSpace (FiniteMeasure X) := by
  let oldM : MeasurableSpace (FiniteMeasure X) := inferInstance
  have hopen : borel (FiniteMeasure X) ≤ oldM :=
    (weak_opensMeasurableSpace (X := X)).borel_le
  refine ⟨le_antisymm ?_ hopen⟩
  letI : MeasurableSpace (FiniteMeasure X) := borel (FiniteMeasure X)
  letI : BorelSpace (FiniteMeasure X) := ⟨rfl⟩
  have hclosed (F : Set X) (hF : IsClosed F) :
      Measurable (fun μ : FiniteMeasure X => (μ : Measure X) F) := by
    apply UpperSemicontinuous.measurable
    rw [upperSemicontinuous_iff_limsup_le]
    intro μ
    exact FiniteMeasure.limsup_measure_closed_le_of_tendsto tendsto_id hF
  have hμ : Measurable (fun μ : FiniteMeasure X => (μ : Measure X)) :=
    Measurable.measure_of_isPiSystem
      (BorelSpace.measurable_eq.trans borel_eq_generateFrom_isClosed)
      isPiSystem_isClosed hclosed (hclosed univ isClosed_univ)
  exact hμ.comap_le

/-- Evaluation measurability is exactly measurability for the Prokhorov Borel
sigma-algebra. This holds already for separable Borel pseudometric spaces. -/
theorem measurable_iff [BorelSpace X] [TopologicalSpace.SeparableSpace X]
    {Ω : Type v} [MeasurableSpace Ω] (Ξ : Ω → FiniteMeasure X) :
    (∀ B : Set X, MeasurableSet B → Measurable (fun ω => (Ξ ω : Measure X) B)) ↔
      @Measurable Ω (LP X) _ (borel (LP X)) (fun ω => LevyProkhorov.ofMeasure (Ξ ω)) := by
  letI : BorelSpace (FiniteMeasure X) := weak_borelSpace
  letI : MeasurableSpace (LP X) := borel (LP X)
  letI : BorelSpace (LP X) := ⟨rfl⟩
  have hΞ : Measurable Ξ ↔ ∀ B : Set X, MeasurableSet B →
      Measurable (fun ω => (Ξ ω : Measure X) B) := by
    exact ⟨fun h B hB => (Measure.measurable_coe hB).comp (measurable_subtype_coe.comp h),
      fun h => (Measure.measurable_measure.mpr h).subtype_mk⟩
  rw [← hΞ]
  constructor
  · intro h
    exact (finiteMeasureHomeomorph (X := X)).continuous.measurable.comp h
  · intro h
    exact (finiteMeasureHomeomorph (X := X)).symm.continuous.measurable.comp h

end Thesis.Foundations.Stochastic.FiniteMeasureBorel
