import Thesis.Foundations.Stochastic.MatchingTuples

/-! # Direct finite-permutation proof of the matching metric laws (interface module)

Alternative route for `thm:permuted-tuple-hausdorff-metric-complete-separable`
(not the mapped proof). The manuscript's verification of the metric laws
(attained finite minima, the bijection `σ ↦ σ⁻¹`, the composition `σ' ∘ σ`,
and the representative-change calculation) now lives in `MatchingTuples`,
which carries the labels. This module is retained for interface stability: it
keeps the former names as aliases of the `MatchingTuples` declarations, and
keeps the one variant `MatchingTuples` does not have, the metric structure
`sourceMetricSpace` whose uniformity is the one generated by `d_π` itself
(`MatchingTuples.matchingMetricSpace` replaces that uniformity by the equal
orbit uniformity of `PermutedTuples` in order to inherit completeness and
separability).
-/

noncomputable section
namespace Thesis.Foundations.Stochastic.MatchingSourceProof

open MarketRepresentation MarketRepresentation.TuplesBasic
open MarketRepresentation.TuplesMetricTopology PermutedTuples MatchingTuples
open scoped ENNReal

universe u

/-! ## Former names, now aliases of the `MatchingTuples` declarations -/

/-- Alias of `MatchingTuples.matchingCost`. -/
alias cost := MatchingTuples.matchingCost

/-- Alias of `MatchingTuples.sup_comp_perm`. -/
alias sup_reindex := MatchingTuples.sup_comp_perm

/-- Alias of `MatchingTuples.truncated_edist_triangle`. -/
alias truncated_triangle := MatchingTuples.truncated_edist_triangle

/-- Alias of `MatchingTuples.matchingCost_symm`. -/
alias cost_inverse := MatchingTuples.matchingCost_symm

/-- Alias of `MatchingTuples.matchingCost_trans_le`. -/
alias cost_composition := MatchingTuples.matchingCost_trans_le

/-- Alias of `MatchingTuples.matchingCost_comp_perm`. -/
alias cost_conjugate := MatchingTuples.matchingCost_comp_perm

/-- Alias of `MatchingTuples.fixedMatchingCost_eq_iInf_matchingCost`. -/
alias fixedMatchingCost_eq_minimum := MatchingTuples.fixedMatchingCost_eq_iInf_matchingCost

/-- Alias of `MatchingTuples.exists_matchingCost_eq_fixedMatchingCost`. -/
alias minimum_attained := MatchingTuples.exists_matchingCost_eq_fixedMatchingCost

/-- Alias of `MatchingTuples.fixedMatchingCost_le_matchingCost`. -/
alias fixedMatchingCost_le_cost := MatchingTuples.fixedMatchingCost_le_matchingCost

export MatchingTuples (fixedMatchingCost_self fixedMatchingCost_eq_zero_iff
  fixedMatchingCost_comm fixedMatchingCost_triangle fixedMatchingCost_representatives)

/-- Alias of `MatchingTuples.matchingEDistance_self`. -/
alias matchingEDistance_self_source := MatchingTuples.matchingEDistance_self

/-- Alias of `MatchingTuples.matchingEDistance_eq_zero`. -/
alias matchingEDistance_zero_source := MatchingTuples.matchingEDistance_eq_zero

/-- Alias of `MatchingTuples.matchingEDistance_comm`. -/
alias matchingEDistance_comm_source := MatchingTuples.matchingEDistance_comm

/-- Alias of `MatchingTuples.matchingEDistance_triangle`. -/
alias matchingEDistance_triangle_source := MatchingTuples.matchingEDistance_triangle

/-- Alias of `MatchingTuples.matchingEMetricSpace`, the extended metric structure
whose axioms are proved by the manuscript's route. -/
alias sourceEMetricSpace := MatchingTuples.matchingEMetricSpace

/-! ## The variant kept here -/

/-- Alternative route for `thm:permuted-tuple-hausdorff-metric-complete-separable`
(not the mapped proof). The metric space on `T^π(X)` obtained directly from
`sourceEMetricSpace`, i.e. with the uniformity generated by `d_π` itself. The
mapped structure `MatchingTuples.matchingMetricSpace` has the same distance but
carries the (equal) orbit uniformity of `PermutedTuples`. -/
@[implicit_reducible] def sourceMetricSpace (X : Type u) [EMetricSpace X] :
    MetricSpace (PermutedTupleQuotientSpace X) := by
  letI := sourceEMetricSpace X
  apply EMetricSpace.toMetricSpace
  intro q r
  exact ne_top_of_le_ne_top (by simp) (matchingEDistance_le_one q r)

theorem sourceMetricSpace_edist (X : Type u) [EMetricSpace X]
    (q r : PermutedTupleQuotientSpace X) :
    @edist _ (sourceMetricSpace X).toEDist q r = matchingEDistance q r := rfl

end Thesis.Foundations.Stochastic.MatchingSourceProof
